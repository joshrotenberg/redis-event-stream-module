    {
      "type": "refactor",
      "section": "Changed",
      "hidden": false
    },
    {
      "type": "remove",
      "section": "Removed",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": false
    },
    {
      "type": "revert",
      "section": "Reverts",
      "hidden": false
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
